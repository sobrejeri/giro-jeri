# ── Supabase ───────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── App ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS: URLs dos frontends ───────────────────────────
TURISTA_URL=http://localhost:5173
COOP_URL=http://localhost:5174
ADMIN_URL=http://localhost:5175

# ── Google Maps (server-side, para validações futuras) ──
GOOGLE_MAPS_API_KEY=your_server_side_key_here

# ── Pagamentos ─────────────────────────────────────────
MERCADO_PAGO_ACCESS_TOKEN=your_mp_token_here
MERCADO_PAGO_WEBHOOK_SECRET=your_webhook_secret_here

# ── Notificações ───────────────────────────────────────
RESEND_API_KEY=your_resend_key_here
EMAIL_FROM=noreply@girojeri.com.br
WHATSAPP_NUMBER=5588999999999

# ── WhatsApp via Z-API ──────────────────────────────────
ZAPI_BASE_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=your_instance_id_here
ZAPI_INSTANCE_TOKEN=your_instance_token_here
ZAPI_CLIENT_TOKEN=your_client_token_here

# ── Web Push / Notificação no celular (VAPID) ───────────
# SEM estas chaves o servidor NÃO envia notificação nenhuma para o aparelho
# (o app até "ativa" a inscrição, mas nada é disparado — vira no-op silencioso).
# As duas são um PAR: gere UMA vez e use o mesmo par em todos os ambientes.
#
# Gerar:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# A pública também é lida pelo frontend via GET /api/notifications/vapid-public-key.
# VAPID_SUBJECT é um mailto: de contato (opcional; tem default).
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:contato@girojeri.com

# ── OTP / Verificação ───────────────────────────────────
# ATENÇÃO: deixe estes campos VAZIOS se não for gerar um valor próprio.
#
# Não coloque aqui um texto de exemplo: qualquer string versionada neste
# arquivo é pública, e as duas variáveis abaixo só são validadas por TAMANHO
# (32+ caracteres). Um placeholder longo copiado para o .env passa na checagem
# e volta a assinar tokens com um segredo conhecido — foi exatamente a falha
# que permitia forjar o link de redefinição de senha e assumir qualquer conta.
#
# Vazio é SEGURO: as libs derivam a chave da SUPABASE_SERVICE_ROLE_KEY
# (obrigatória para a API subir, alta entropia e nunca versionada), com uma
# chave distinta por finalidade. Ver packages/api/src/lib/tokenSecret.js.
#
# Para usar um valor próprio, gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Pepper do HMAC do código OTP (opcional)
OTP_PEPPER=

# Segredo dos tokens curtos: ativação de cadastro e redefinição de senha (opcional)
SIGNUP_TOKEN_SECRET=
