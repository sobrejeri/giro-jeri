{
  "name": "giro-jeri",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/api",
    "dev:api": "npm run dev --workspace=packages/api",
    "dev:coop": "npm run dev --workspace=packages/cooperativa",
    "dev:admin": "npm run dev --workspace=packages/admin",
    "dev:turista": "npm run dev --workspace=packages/turista",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev:coop\" \"npm run dev:admin\" \"npm run dev:turista\"",
    "build:coop": "npm run build --workspace=packages/cooperativa",
    "build:admin": "npm run build --workspace=packages/admin",
    "start": "npm run start --workspace=packages/api",
    "install:all": "npm install",
    "test": "npm run test:api && npm run test:turista",
    "test:api": "npm run test --workspace=packages/api",
    "test:turista": "npm run test --workspace=packages/turista",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:api": "playwright test e2e/04-api-smoke.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
